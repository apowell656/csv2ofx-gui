# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# PyInstaller
*.manifest
*.toc
*.pkg

# Installer artifacts
*.dmg
*.pkg
*.exe
*.msi
*.AppImage
packaging/AppDir/
packaging/deb/
packaging/tools/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.ruff_cache/
.pyre/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# macOS / Windows
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Local config / secrets
.env
.env.*
*.local
config.local.*
settings.local.*

# User data / generated app data
data/
output/
exports/
imports/
profiles/
bank_profiles/
sample_output/

# CSV / OFX files - avoid committing real financial data
*.csv
*.ofx
*.qfx
*.qif

# Allow sanitized examples if you want them
!examples/
!examples/**/*.csv
!examples/**/*.ofx
!samples/
!samples/**/*.csv
!samples/**/*.ofx
# Local PyInstaller cache
.pyinstaller/
